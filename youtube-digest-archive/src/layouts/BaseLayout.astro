---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "YouTube Digest — 매일 한 편, 기술 다이제스트" } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#fbf9f4" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>

		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="masthead">
				<a href="/" class="masthead-mark">YouTube <em>Digest</em></a>
				<span class="masthead-tag">Daily Reading</span>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} YouTube Digest</p>
		</footer>
	</body>
</html>
