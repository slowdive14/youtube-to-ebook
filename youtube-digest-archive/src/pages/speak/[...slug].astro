---
// src/pages/speak/[...slug].astro — daily "오늘의 한 마디" speaking output
// Two gentle steps, both via MediaRecorder -> Gemini (no Web Speech, no pass/fail):
//   1) Warm-up: shadow (repeat) a few key sentences from the article
//   2) Produce: say your own one sentence
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const issues = await getCollection('issues');
	return issues
		.filter((issue) => issue.data.speakingPrompt)
		.map((issue) => ({ params: { slug: issue.id }, props: { issue } }));
}

const { issue } = Astro.props;
const sp = issue.data.speakingPrompt!;
// Easy, practical B1-B2 warm-up sentences (NOT verbatim article quotes).
// Prefer the new speakingPrompt.shadow; fall back to old drill sentences for
// legacy issues that predate the shadow field.
const shadows = (sp.shadow && sp.shadow.length > 0)
	? sp.shadow.map((s) => ({ sentence: s.en, korean: s.ko }))
	: (issue.data.drillSentences || []).slice(0, 3).map((d) => ({ sentence: d.sentence, korean: d.korean }));
const dateObj = new Date(issue.data.date);
const formattedDate = dateObj.toLocaleDateString('en-US', {
	year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={`오늘의 한 마디 - ${formattedDate}`}>
	<div class="speak">
		<header class="speak-head">
			<a href={`/issues/${issue.id}`} class="speak-back">&larr; Back to article</a>
			<h1>오늘의 한 마디</h1>
			<p class="speak-date">{formattedDate}{sp.topic ? ` · ${sp.topic}` : ''}</p>
			<div id="streak" class="streak" hidden></div>
		</header>

		{shadows.length > 0 && (
			<section class="warmup">
				<h2 class="section-title">1단계 · 워밍업 <span class="section-sub">한 문장을 3단계로 올라가며 말해요</span></h2>
				{shadows.map((s, i) => (
					<div class="card ladder-card" data-idx={i} data-en={s.sentence} data-ko={s.korean} data-step="1">
						<div class="ladder-steps">
							<span class="lstep" data-s="1">1 따라</span>
							<span class="lstep" data-s="2">2 빈칸</span>
							<span class="lstep" data-s="3">3 한→영</span>
						</div>
						<p class="lp-en" id={`en-s${i}`}></p>
						<p class="lp-ko" id={`ko-s${i}`}>{s.korean}</p>
						<div class="ladder-actions">
							<button class="mini-btn say-btn lp-say" data-say={s.sentence} type="button" id={`say-s${i}`}>🔊 듣기</button>
							<button class="rec-btn rec-btn-sm ladder-rec" data-rec={`s${i}`} type="button">🎤 말하기</button>
							<button class="mini-btn ladder-next" id={`next-s${i}`} hidden type="button">다음 단계 →</button>
						</div>
						<div class="ladder-fb" id={`fb-s${i}`} hidden>
							<p class="fb-transcript" id={`t-s${i}`}></p>
							<p class="fb-good" id={`g-s${i}`}></p>
							<p class="fb-tip" id={`tip-s${i}`}></p>
						</div>
					</div>
				))}
			</section>
		)}

		<!-- Production task -->
		<section class="produce">
			<h2 class="section-title">{shadows.length > 0 ? '2단계 · 내 문장 만들기' : '오늘의 과제'} <span class="section-sub">내 생각을 한 문장으로</span></h2>
			<div class="card task">
				<p class="task-q">{sp.question_ko}</p>
				<div class="task-frame" aria-label="sentence frame">{sp.frame}</div>
				{sp.expressions && sp.expressions.length > 0 && (
					<div class="chips">
						{sp.expressions.map((e) => (
							<button class="chip say-btn" data-say={e.en} title="탭하면 발음 들려줘요">
								<span class="chip-en">{e.en}</span>
								{e.ko && <span class="chip-ko">{e.ko}</span>}
							</button>
						))}
					</div>
				)}
			</div>

			<div class="recorder">
				<button data-rec="produce" class="rec-btn" type="button" aria-live="polite">
					<svg class="rec-ico" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
					<span>🎤 한 마디 말하기</span>
				</button>
				<p id="produce-hint" class="rec-hint">버튼을 누르고 영어로 한 문장 말한 뒤, 다시 눌러 멈춰요.</p>
			</div>

			<div id="feedback" class="card feedback" hidden>
				<div class="fb-row"><span class="fb-label">🗣️ 내가 말한 것</span><p id="fb-transcript" class="fb-transcript"></p></div>
				<div class="fb-row fb-good"><span class="fb-label">✅ 좋아요</span><p id="fb-good"></p></div>
				<div class="fb-row"><span class="fb-label">✏️ 더 자연스럽게</span><p id="fb-corrected" class="fb-en"></p></div>
				<div class="fb-row"><span class="fb-label">🌟 한 단계 업</span><p id="fb-upgrade"></p></div>
				<div class="fb-row fb-model">
					<span class="fb-label">🔊 모델 답안 (따라 말해보기)</span>
					<p id="fb-model" class="fb-en"></p>
					<button id="fb-play" class="mini-btn" type="button">🔊 듣기</button>
				</div>
			</div>
		</section>

		<!-- My recent sentences -->
		<section id="log" class="card log" hidden>
			<h2 class="log-title">📒 내 문장 기록</h2>
			<ul id="log-list" class="log-list"></ul>
		</section>

		{issue.data.drillSentences && issue.data.drillSentences.length > 0 && (
			<p class="more"><a href={`/drill/${issue.id}`}>더 어려운 연습 (빈칸·번역 드릴) →</a></p>
		)}
	</div>

	<script define:vars={{ sp, shadows }}>
		window.__SPEAK__ = { sp, shadows };
	</script>

	<script>
		const { sp } = window.__SPEAK__;
		const $ = (id) => document.getElementById(id);

		// --- TTS ---
		function say(text, rate = 0.9) {
			if (!window.speechSynthesis) return;
			window.speechSynthesis.cancel();
			const u = new SpeechSynthesisUtterance(text);
			u.lang = 'en-US'; u.rate = rate;
			window.speechSynthesis.speak(u);
		}
		document.querySelectorAll('.say-btn').forEach((b) => {
			b.addEventListener('click', (e) => { e.stopPropagation(); say(b.dataset.say); });
		});

		// --- recorder support ---
		function pickMime() {
			if (!window.MediaRecorder) return null;
			for (const t of ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg'])
				if (MediaRecorder.isTypeSupported(t)) return t;
			return '';
		}
		const mimeType = pickMime();

		// --- generic single-recorder shared by all 🎤 buttons ---
		let media = null, stream = null, chunks = [], activeId = null, autoStop = null;
		const targets = {}; // id -> { btn, label, buildPayload, render, onError }

		function btnFor(id) { return document.querySelector(`[data-rec="${id}"]`); }

		async function startRec(id) {
			if (activeId) return; // one at a time
			const t = targets[id];
			try {
				stream = await navigator.mediaDevices.getUserMedia({ audio: true });
			} catch (e) {
				t.onError('마이크 권한이 필요해요. 브라우저 설정에서 허용해 주세요.');
				return;
			}
			chunks = [];
			try { media = new MediaRecorder(stream, mimeType ? { mimeType } : undefined); }
			catch (e) { media = new MediaRecorder(stream); }
			media.ondataavailable = (ev) => { if (ev.data.size > 0) chunks.push(ev.data); };
			media.onstop = () => finishRec(id);
			media.start();
			activeId = id;
			t.setLabel('● 녹음 중… (눌러서 멈추기)', true);
			autoStop = setTimeout(() => { if (activeId === id) stopRec(); }, 20000);
		}
		function stopRec() {
			if (autoStop) clearTimeout(autoStop);
			if (media && media.state !== 'inactive') media.stop();
			if (stream) stream.getTracks().forEach((tr) => tr.stop());
		}
		async function finishRec(id) {
			const t = targets[id];
			t.setLabel('⏳ 듣는 중…', false, true);
			const blob = new Blob(chunks, { type: media.mimeType || mimeType || 'audio/webm' });
			const audioBase64 = await blobToBase64(blob);
			try {
				const res = await fetch('/api/speak-feedback', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ audioBase64, mimeType: blob.type, ...t.buildPayload() }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || 'failed');
				t.render(data);
				t.reset();
			} catch (e) {
				t.onError('문제가 생겼어요. 다시 한 번 시도해 주세요.');
			}
			activeId = null;
		}
		function blobToBase64(blob) {
			return new Promise((resolve) => {
				const r = new FileReader();
				r.onloadend = () => resolve(String(r.result).split(',')[1] || '');
				r.readAsDataURL(blob);
			});
		}

		function wire(id) {
			const btn = btnFor(id);
			if (btn) btn.addEventListener('click', () => {
				if (activeId === id) stopRec();
				else if (!activeId) startRec(id);
			});
		}

		// --- warm-up ladder: each sentence climbs shadow -> fill -> translate ---
		const STEP_LABEL = { 1: '🎤 따라 말하기', 2: '🎤 빈칸 채워 말하기', 3: '🎤 한국어 보고 영어로' };

		function blankWord(en) {
			const tokens = en.split(/(\s+)/); // keep whitespace tokens
			let bestIdx = -1, bestLen = 0;
			tokens.forEach((tok, idx) => {
				const w = tok.replace(/[^A-Za-z]/g, '');
				if (w.length >= 4 && w.length > bestLen) { bestLen = w.length; bestIdx = idx; }
			});
			if (bestIdx === -1) return en;
			tokens[bestIdx] = tokens[bestIdx].replace(/[A-Za-z]+/, '____');
			return tokens.join('');
		}

		document.querySelectorAll('.ladder-card').forEach((card) => {
			const i = card.dataset.idx;
			const id = `s${i}`;
			const en = card.dataset.en, ko = card.dataset.ko;
			const recBtn = card.querySelector('.ladder-rec');
			const sayBtn = $(`say-s${i}`);
			const nextBtn = $(`next-s${i}`);
			const enEl = $(`en-s${i}`);
			const fb = $(`fb-${id}`);
			const step = () => parseInt(card.dataset.step || '1');

			function renderStep() {
				const s = step();
				card.querySelectorAll('.lstep').forEach((el) => {
					const n = parseInt(el.dataset.s);
					el.classList.toggle('active', n === s);
					el.classList.toggle('done', n < s);
				});
				if (s === 1) enEl.textContent = en;
				else if (s === 2) enEl.textContent = blankWord(en);
				else enEl.textContent = '';            // translate: hide English
				sayBtn.hidden = s !== 1;
				recBtn.textContent = STEP_LABEL[s];
				recBtn.disabled = false;
				nextBtn.hidden = true;
				fb.hidden = true;
			}

			targets[id] = {
				buildPayload: () => (step() === 3
					? { mode: 'translate', target: en, ko }
					: { mode: 'shadow', target: en }),
				setLabel: (label) => { recBtn.textContent = label; recBtn.disabled = label.includes('듣는'); },
				reset: () => { recBtn.textContent = '🎤 다시 말하기'; recBtn.disabled = false; },
				onError: (msg) => { $(`t-${id}`).textContent = msg; fb.hidden = false; recBtn.textContent = STEP_LABEL[step()]; recBtn.disabled = false; },
				render: (d) => {
					$(`t-${id}`).textContent = d.transcript ? `🗣️ ${d.transcript}` : '(못 알아들었어요 — 다시 한 번!)';
					$(`g-${id}`).textContent = d.good || '';
					$(`tip-${id}`).textContent = step() === 3
						? (d.corrected ? `✏️ ${d.corrected}` : '')
						: (d.tip || '');
					fb.hidden = false;
					if (step() < 3) nextBtn.hidden = false;
				},
			};
			nextBtn.addEventListener('click', () => {
				card.dataset.step = String(Math.min(3, step() + 1));
				renderStep();
			});
			wire(id);
			renderStep();
		});

		// --- register production target ---
		const pHint = $('produce-hint');
		const pBtnLabel = btnFor('produce').querySelector('span');
		targets['produce'] = {
			buildPayload: () => ({ mode: 'produce', question: sp.question_ko || '', model: sp.model || '' }),
			setLabel: (label) => { pBtnLabel.textContent = label; btnFor('produce').disabled = label.includes('듣는'); },
			reset: () => { pBtnLabel.textContent = '🎤 다시 말하기'; btnFor('produce').disabled = false; },
			onError: (msg) => { pHint.textContent = msg; pBtnLabel.textContent = '🎤 한 마디 말하기'; btnFor('produce').disabled = false; },
			render: (d) => {
				$('fb-transcript').textContent = d.transcript || '(못 알아들었어요 — 다시 한 번!)';
				$('fb-good').textContent = d.good || '';
				$('fb-corrected').textContent = d.corrected || '';
				$('fb-upgrade').textContent = d.upgrade || '';
				$('fb-model').textContent = d.model_answer || sp.model || '';
				$('feedback').hidden = false;
				$('feedback').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				recordToday(d);
			},
		};
		wire('produce');
		$('fb-play').addEventListener('click', () => say($('fb-model').textContent, 0.85));

		if (mimeType === null) {
			document.querySelectorAll('.rec-btn').forEach((b) => (b.disabled = true));
			pHint.textContent = '이 브라우저는 녹음을 지원하지 않아요. Chrome 또는 Safari를 사용해 주세요.';
		}

		// --- streak + log (local calendar day) ---
		function loadLog() { try { return JSON.parse(localStorage.getItem('speakLog') || '[]'); } catch (e) { return []; } }
		function isoDay(d) {
			const y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0'), day = String(d.getDate()).padStart(2, '0');
			return `${y}-${m}-${day}`;
		}
		function computeStreak(dates, todayStr) {
			const set = new Set(dates);
			let d = new Date(todayStr + 'T00:00:00');
			if (!set.has(isoDay(d))) d.setDate(d.getDate() - 1);
			let n = 0;
			while (set.has(isoDay(d))) { n++; d.setDate(d.getDate() - 1); }
			return n;
		}
		function recordToday(d) {
			try {
				const today = isoDay(new Date());
				const log = loadLog();
				log.unshift({ date: today, said: d.transcript || '', better: d.corrected || '' });
				localStorage.setItem('speakLog', JSON.stringify(log.slice(0, 60)));
			} catch (e) {}
			renderStreakAndLog();
		}
		function renderStreakAndLog() {
			const log = loadLog();
			const streak = computeStreak(log.map((e) => e.date), isoDay(new Date()));
			const streakEl = $('streak');
			if (streak > 0) { streakEl.textContent = `🔥 ${streak}일 연속`; streakEl.hidden = false; }
			else streakEl.hidden = true;
			const seen = new Set(), recent = [];
			for (const e of log) { if (seen.has(e.date)) continue; seen.add(e.date); recent.push(e); if (recent.length >= 7) break; }
			const logEl = $('log'), listEl = $('log-list');
			if (recent.length === 0) { logEl.hidden = true; return; }
			listEl.innerHTML = '';
			for (const e of recent) {
				const li = document.createElement('li');
				li.className = 'log-item';
				const said = (e.said || '').replace(/</g, '&lt;');
				const better = (e.better || '').replace(/</g, '&lt;');
				li.innerHTML = `<span class="log-date">${e.date}</span>` +
					(said ? `<span class="log-said">🗣️ ${said}</span>` : '') +
					(better ? `<span class="log-better">✏️ ${better}</span>` : '');
				listEl.appendChild(li);
			}
			logEl.hidden = false;
		}
		renderStreakAndLog();
	</script>

	<style>
		.speak { max-width: 640px; margin: 0 auto; padding: 0 1rem 3rem; }
		.speak-head { text-align: center; padding: 1.5rem 0 0.5rem; }
		.speak-head h1 { margin: 0.3rem 0; font-size: 1.8rem; }
		.speak-back { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
		.speak-date { color: var(--text-muted); font-size: 0.9rem; }
		.section-title { font-size: 1.15rem; margin: 1.6rem 0 0.6rem; }
		.section-sub { font-size: 0.85rem; color: var(--text-muted); font-weight: 400; }
		.card { background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: 12px; padding: 1.25rem 1.4rem; margin: 0.7rem 0; }
		.ladder-card { padding: 1rem 1.2rem; }
		.ladder-steps { display: flex; gap: 0.4rem; margin-bottom: 0.7rem; }
		.lstep { font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 999px; background: var(--code-bg); color: var(--text-muted); border: 1px solid var(--code-border); }
		.lstep.active { background: var(--accent-color); color: #fff; border-color: transparent; font-weight: 700; }
		.lstep.done { color: #2e7d32; }
		.lp-en { font-size: 1.15rem; font-weight: 600; margin: 0 0 0.2rem; min-height: 1.2em; }
		.lp-ko { font-size: 0.95rem; color: var(--text-muted); margin: 0 0 0.7rem; }
		.ladder-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
		.ladder-fb { margin-top: 0.8rem; padding-top: 0.7rem; border-top: 1px solid var(--divider-color); }
		.ladder-fb p { margin: 0.15rem 0; line-height: 1.5; }
		.fb-tip { color: #e65100; font-size: 0.95rem; }
		.task-q { font-size: 1.25rem; font-weight: 600; line-height: 1.5; margin: 0 0 1rem; }
		.task-frame { font-size: 1.1rem; padding: 0.7rem 1rem; background: var(--intro-bg); border-left: 4px solid var(--accent-color); border-radius: 6px; font-style: italic; color: var(--text-color); }
		.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
		.chip { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 2px; background: var(--code-bg); border: 1px solid var(--code-border); border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer; font: inherit; }
		.chip-en { font-weight: 600; color: var(--text-color); }
		.chip-ko { font-size: 0.78rem; color: var(--text-muted); }
		.recorder { text-align: center; margin: 1.2rem 0; }
		.rec-btn { display: inline-flex; align-items: center; gap: 0.6rem; background: var(--accent-color); color: #fff; border: none; border-radius: 999px; padding: 0.9rem 1.8rem; font-size: 1.15rem; font-weight: 600; cursor: pointer; transition: transform 0.1s, background 0.2s; }
		.rec-btn:hover { transform: translateY(-1px); }
		.rec-btn:disabled { opacity: 0.6; cursor: default; }
		.rec-btn-sm { font-size: 0.95rem; padding: 0.5rem 1.1rem; }
		.rec-hint { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.8rem; }
		.feedback { margin-top: 1rem; }
		.fb-row { padding: 0.7rem 0; border-bottom: 1px solid var(--divider-color); }
		.fb-row:last-of-type { border-bottom: none; }
		.fb-label { display: block; font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.3rem; }
		.fb-row p { margin: 0; line-height: 1.6; }
		.fb-en { font-size: 1.1rem; }
		.fb-transcript { color: var(--text-muted); font-style: italic; }
		.mini-btn { background: var(--code-bg); border: 1px solid var(--code-border); border-radius: 6px; padding: 0.45rem 0.9rem; cursor: pointer; font: inherit; color: var(--text-color); }
		.more { text-align: center; margin-top: 1.5rem; }
		.more a { color: var(--text-muted); font-size: 0.9rem; }
		.streak { display: inline-block; margin-top: 0.6rem; padding: 0.3rem 0.9rem; background: #fff3e0; color: #e65100; border-radius: 999px; font-weight: 700; font-size: 0.95rem; }
		.log-title { font-size: 1.05rem; margin: 0 0 0.8rem; }
		.log-list { list-style: none; margin: 0; padding: 0; }
		.log-item { display: flex; flex-direction: column; gap: 2px; padding: 0.6rem 0; border-bottom: 1px solid var(--divider-color); }
		.log-item:last-child { border-bottom: none; }
		.log-date { font-size: 0.78rem; color: var(--text-muted); }
		.log-said { color: var(--text-muted); font-style: italic; }
		.log-better { color: var(--text-color); }
	</style>
</BaseLayout>
