---
// src/pages/speak/[...slug].astro — daily "오늘의 한 마디" speaking output
// Two gentle steps, both via MediaRecorder -> Gemini (no Web Speech, no pass/fail):
//   1) Warm-up: shadow (repeat) a few key sentences from the article
//   2) Produce: say your own one sentence
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const issues = await getCollection('issues');
	return issues
		.filter((issue) => issue.data.speakingPrompt)
		.map((issue) => ({ params: { slug: issue.id }, props: { issue } }));
}

const { issue } = Astro.props;
const sp = issue.data.speakingPrompt!;
// A "lesson" is one reusable pattern practiced across connected steps:
//   1) shadow s1  2) fill s2 (same pattern)  3) apply the pattern to your life
// Prefer speakingPrompt.patterns; fall back to legacy shadow sentences
// (which only support step 1).
const patterns = (sp as any).patterns || [];
const lessons = patterns.length > 0
	? patterns.map((p: any) => ({
		pattern: p.pattern, pattern_ko: p.pattern_ko || '',
		s1_en: p.s1_en, s1_ko: p.s1_ko || '',
		s2_en: p.s2_en, s2_ko: p.s2_ko || '', s2_answer: p.s2_answer || '',
		maxStep: 3,
	}))
	: (sp.shadow || []).map((s) => ({ pattern: '', pattern_ko: '', s1_en: s.en, s1_ko: s.ko, s2_en: '', s2_ko: '', s2_answer: '', maxStep: 1 }));
const dateObj = new Date(issue.data.date);
const formattedDate = dateObj.toLocaleDateString('ko-KR', {
	year: 'numeric', month: 'long', day: 'numeric',
});
// The lesson's own calendar day (YYYY-MM-DD). Sentence-log entries are tagged
// with THIS, so a sentence made for the 06-11 digest is filed under 06-11 —
// not under "today". (Practice-day timing still uses the real calendar day.)
const rawIssueDate = issue.data.date;
const issueDay = (rawIssueDate instanceof Date)
	? rawIssueDate.toISOString().slice(0, 10)
	: String(rawIssueDate).slice(0, 10);
---

<BaseLayout title={`오늘의 한 마디 - ${formattedDate}`}>
	<div class="speak" data-issue-date={issueDay}>
		<header class="speak-head">
			<a href={`/issues/${issue.id}`} class="speak-back">&larr; Back to article</a>
			<h1>오늘의 한 마디</h1>
			<p class="speak-date">{formattedDate}{sp.topic ? ` · ${sp.topic}` : ''}</p>
			<div id="streak" class="streak" hidden></div>
		</header>

		<!-- Review: re-say sentences you fixed on earlier days (filled by JS) -->
		<section id="review" class="warmup" hidden>
			<h2 class="section-title">🔁 복습 <span class="section-sub">지난번 고친 문장, 한국어 보고 영어로</span></h2>
			<div id="review-list"></div>
		</section>

		{lessons.length > 0 && (
			<section class="warmup">
				<h2 class="section-title">1단계 · 패턴 연습 <span class="section-sub">한 표현을 따라→응용→내 것으로</span></h2>
				{lessons.map((l: any, i: number) => (
					<div class="card ladder-card" data-idx={i} data-step="1" data-maxstep={l.maxStep}
						data-pattern={l.pattern} data-pko={l.pattern_ko}
						data-s1={l.s1_en} data-s1ko={l.s1_ko}
						data-s2={l.s2_en} data-s2ko={l.s2_ko} data-ans={l.s2_answer}>
						{l.pattern && <div class="lp-pattern">{l.pattern} <span class="lp-pattern-ko">{l.pattern_ko}</span></div>}
						<div class="ladder-steps">
							<span class="lstep" data-s="1">1 따라</span>
							{l.maxStep >= 2 && <span class="lstep" data-s="2">2 빈칸</span>}
							{l.maxStep >= 3 && <span class="lstep" data-s="3">3 내 상황</span>}
						</div>
						<p class="lp-en" id={`en-s${i}`}></p>
						<p class="lp-ko" id={`ko-s${i}`}></p>
						<div class="ladder-actions">
							<button class="mini-btn say-btn lp-say" data-say={l.s1_en} type="button" id={`say-s${i}`}>🔊 듣기</button>
							<button class="rec-btn rec-btn-sm ladder-rec" data-rec={`s${i}`} type="button">🎤 말하기</button>
							<button class="mini-btn ladder-next" id={`next-s${i}`} hidden type="button">다음 단계 →</button>
						</div>
						<div class="ladder-fb" id={`fb-s${i}`} hidden>
							<p class="fb-transcript" id={`t-s${i}`}></p>
							<p class="fb-good" id={`g-s${i}`}></p>
							<p class="fb-tip" id={`tip-s${i}`}></p>
						</div>
					</div>
				))}
			</section>
		)}

		<!-- Production task -->
		<section class="produce">
			<h2 class="section-title">{lessons.length > 0 ? '2단계 · 내 문장 만들기' : '오늘의 과제'} <span class="section-sub">{lessons.length > 0 ? '위 1단계 표현을 그대로 써서 한 문장으로' : '내 생각을 한 문장으로'}</span></h2>
			<div class="card task">
				<p class="task-q">{sp.question_ko}</p>
				<div class="task-frame" aria-label="sentence frame">{sp.frame}</div>
				{sp.expressions && sp.expressions.length > 0 && (
					<div class="chips">
						{sp.expressions.map((e) => (
							<button class="chip say-btn" data-say={e.en} title="탭하면 발음 들려줘요">
								<span class="chip-en">{e.en}</span>
								{e.ko && <span class="chip-ko">{e.ko}</span>}
							</button>
						))}
					</div>
				)}
			</div>

			<div class="recorder">
				<button data-rec="produce" class="rec-btn" type="button" aria-live="polite">
					<svg class="rec-ico" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
					<span>🎤 한 마디 말하기</span>
				</button>
				<p id="produce-hint" class="rec-hint">버튼을 누르고 영어로 한 문장 말한 뒤, 다시 눌러 멈춰요.</p>
			</div>

			<div id="feedback" class="card feedback" hidden>
				<div class="fb-row"><span class="fb-label">🗣️ 내가 말한 것</span><p id="fb-transcript" class="fb-transcript"></p></div>
				<div class="fb-row fb-good"><span class="fb-label">✅ 좋아요</span><p id="fb-good"></p></div>
				<div class="fb-row"><span class="fb-label">✏️ 더 자연스럽게</span><p id="fb-corrected" class="fb-en"></p></div>
				<div class="fb-row"><span class="fb-label">🌟 한 단계 업</span><p id="fb-upgrade"></p></div>
				<div class="fb-row fb-model">
					<span class="fb-label">🔊 모델 답안 (따라 말해보기)</span>
					<p id="fb-model" class="fb-en"></p>
					<button id="fb-play" class="mini-btn" type="button">🔊 듣기</button>
				</div>
				<div class="fb-row fb-reshadow">
					<span class="fb-label">🔁 자연스러운 버전 내 입에 붙이기</span>
					<p id="fb-corrected2" class="fb-en"></p>
					<div class="ladder-actions">
						<button id="fb-corr-play" class="mini-btn" type="button">🔊 듣기</button>
						<button data-rec="reshadow" class="rec-btn rec-btn-sm" type="button">🎤 따라 말하기</button>
					</div>
					<div class="ladder-fb" id="fb-reshadow-fb" hidden>
						<p id="t-reshadow"></p>
						<p id="g-reshadow"></p>
						<p id="tip-reshadow"></p>
					</div>
				</div>
			</div>
		</section>

		<!-- My learned sentences + recurring mistakes -->
		<section id="log" class="card log" hidden>
			<h2 class="log-title">📒 내 표현 &amp; 실수 노트</h2>
			<div id="mistake-summary" class="mistake-summary" hidden></div>
			<ul id="log-list" class="log-list"></ul>
		</section>

	</div>

	<script define:vars={{ sp, lessons }}>
		window.__SPEAK__ = { sp, lessons };
	</script>

	<script>
		const { sp } = window.__SPEAK__;
		const $ = (id) => document.getElementById(id);

		// --- TTS ---
		function say(text, rate = 0.9) {
			if (!window.speechSynthesis) return;
			window.speechSynthesis.cancel();
			const u = new SpeechSynthesisUtterance(text);
			u.lang = 'en-US'; u.rate = rate;
			window.speechSynthesis.speak(u);
		}
		document.querySelectorAll('.say-btn').forEach((b) => {
			b.addEventListener('click', (e) => { e.stopPropagation(); say(b.dataset.say); });
		});

		// --- recorder support ---
		function pickMime() {
			if (!window.MediaRecorder) return null;
			for (const t of ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg'])
				if (MediaRecorder.isTypeSupported(t)) return t;
			return '';
		}
		const mimeType = pickMime();

		// --- generic single-recorder shared by all 🎤 buttons ---
		let media = null, stream = null, chunks = [], activeId = null, autoStop = null;
		const targets = {}; // id -> { btn, label, buildPayload, render, onError }

		function btnFor(id) { return document.querySelector(`[data-rec="${id}"]`); }

		async function startRec(id) {
			if (activeId) return; // one at a time
			const t = targets[id];
			try {
				stream = await navigator.mediaDevices.getUserMedia({ audio: true });
			} catch (e) {
				t.onError('마이크 권한이 필요해요. 브라우저 설정에서 허용해 주세요.');
				return;
			}
			chunks = [];
			try { media = new MediaRecorder(stream, mimeType ? { mimeType } : undefined); }
			catch (e) { media = new MediaRecorder(stream); }
			media.ondataavailable = (ev) => { if (ev.data.size > 0) chunks.push(ev.data); };
			media.onstop = () => finishRec(id);
			media.start();
			activeId = id;
			t.setLabel('● 녹음 중… (눌러서 멈추기)', true);
			autoStop = setTimeout(() => { if (activeId === id) stopRec(); }, 20000);
		}
		function stopRec() {
			if (autoStop) clearTimeout(autoStop);
			if (media && media.state !== 'inactive') media.stop();
			if (stream) stream.getTracks().forEach((tr) => tr.stop());
		}
		async function finishRec(id) {
			const t = targets[id];
			t.setLabel('⏳ 듣는 중…', false, true);
			const blob = new Blob(chunks, { type: media.mimeType || mimeType || 'audio/webm' });
			const audioBase64 = await blobToBase64(blob);
			try {
				const res = await fetch('/api/speak-feedback', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ audioBase64, mimeType: blob.type, ...t.buildPayload() }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || 'failed');
				t.render(data);
				t.reset();
			} catch (e) {
				t.onError('문제가 생겼어요. 다시 한 번 시도해 주세요.');
			}
			activeId = null;
		}
		function blobToBase64(blob) {
			return new Promise((resolve) => {
				const r = new FileReader();
				r.onloadend = () => resolve(String(r.result).split(',')[1] || '');
				r.readAsDataURL(blob);
			});
		}

		function wire(id) {
			const btn = btnFor(id);
			if (btn) btn.addEventListener('click', () => {
				if (activeId === id) stopRec();
				else if (!activeId) startRec(id);
			});
		}

		// --- warm-up ladder: one PATTERN climbs shadow(s1) -> fill(s2) -> apply ---
		const STEP_LABEL = { 1: '🎤 따라 말하기', 2: '🎤 빈칸 채워 말하기', 3: '🎤 내 상황을 말하기' };

		function blankAnswer(en, answer) {
			if (answer) {
				const idx = en.toLowerCase().indexOf(answer.toLowerCase());
				if (idx !== -1) return en.slice(0, idx) + '____' + en.slice(idx + answer.length);
			}
			// fallback: blank the longest word
			const tokens = en.split(/(\s+)/);
			let bestIdx = -1, bestLen = 0;
			tokens.forEach((tok, idx) => {
				const w = tok.replace(/[^A-Za-z]/g, '');
				if (w.length >= 4 && w.length > bestLen) { bestLen = w.length; bestIdx = idx; }
			});
			if (bestIdx !== -1) tokens[bestIdx] = tokens[bestIdx].replace(/[A-Za-z]+/, '____');
			return tokens.join('');
		}

		document.querySelectorAll('.ladder-card').forEach((card) => {
			const i = card.dataset.idx;
			const id = `s${i}`;
			const d0 = card.dataset;
			const maxStep = parseInt(d0.maxstep || '1');
			const recBtn = card.querySelector('.ladder-rec');
			const sayBtn = $(`say-s${i}`);
			const nextBtn = $(`next-s${i}`);
			const enEl = $(`en-s${i}`);
			const koEl = $(`ko-s${i}`);
			const fb = $(`fb-${id}`);
			const step = () => parseInt(card.dataset.step || '1');

			function renderStep() {
				const s = step();
				card.querySelectorAll('.lstep').forEach((el) => {
					const n = parseInt(el.dataset.s);
					el.classList.toggle('active', n === s);
					el.classList.toggle('done', n < s);
				});
				if (s === 1) { enEl.textContent = d0.s1; koEl.textContent = d0.s1ko; sayBtn.dataset.say = d0.s1; sayBtn.hidden = false; }
				else if (s === 2) { enEl.textContent = blankAnswer(d0.s2, d0.ans); koEl.textContent = d0.s2ko; sayBtn.dataset.say = d0.s2; sayBtn.hidden = false; }
				else { enEl.textContent = ''; koEl.textContent = `이 패턴으로 내 상황을 한 문장 말해보세요: ${d0.pattern}`; sayBtn.hidden = true; }
				recBtn.textContent = STEP_LABEL[s];
				recBtn.disabled = false;
				nextBtn.hidden = true;
				fb.hidden = true;
			}

			targets[id] = {
				buildPayload: () => {
					const s = step();
					if (s === 1) return { mode: 'shadow', target: d0.s1 };
					if (s === 2) return { mode: 'shadow', target: d0.s2 };
					return { mode: 'apply', target: d0.pattern };
				},
				setLabel: (label) => { recBtn.textContent = label; recBtn.disabled = label.includes('듣는'); },
				reset: () => { recBtn.textContent = '🎤 다시 말하기'; recBtn.disabled = false; },
				onError: (msg) => { $(`t-${id}`).textContent = msg; fb.hidden = false; recBtn.textContent = STEP_LABEL[step()]; recBtn.disabled = false; },
				render: (d) => {
					$(`t-${id}`).textContent = d.transcript ? `🗣️ ${d.transcript}` : '(못 알아들었어요 — 다시 한 번!)';
					$(`g-${id}`).textContent = d.good || '';
					// steps 1-2 (shadow) return tip; step 3 (apply) returns corrected
					$(`tip-${id}`).textContent = step() === 3
						? (d.corrected ? `✏️ ${d.corrected}` : '')
						: (d.tip || '');
					fb.hidden = false;
					if (step() === 3 && d.corrected) saveProduction(d);
					if (step() < maxStep) nextBtn.hidden = false;
				},
			};
			nextBtn.addEventListener('click', () => {
				card.dataset.step = String(Math.min(maxStep, step() + 1));
				renderStep();
			});
			wire(id);
			renderStep();
		});

		// --- register production target ---
		const pHint = $('produce-hint');
		const pBtnLabel = btnFor('produce').querySelector('span');
		targets['produce'] = {
			buildPayload: () => ({ mode: 'produce', question: sp.question_ko || '', model: sp.model || '' }),
			setLabel: (label) => { pBtnLabel.textContent = label; btnFor('produce').disabled = label.includes('듣는'); },
			reset: () => { pBtnLabel.textContent = '🎤 다시 말하기'; btnFor('produce').disabled = false; },
			onError: (msg) => { pHint.textContent = msg; pBtnLabel.textContent = '🎤 한 마디 말하기'; btnFor('produce').disabled = false; },
			render: (d) => {
				$('fb-transcript').textContent = d.transcript || '(못 알아들었어요 — 다시 한 번!)';
				$('fb-good').textContent = d.good || '';
				$('fb-corrected').textContent = d.corrected || '';
				$('fb-upgrade').textContent = d.upgrade || '';
				$('fb-model').textContent = d.model_answer || sp.model || '';
				$('feedback').hidden = false;
				$('feedback').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				reshadowTarget = (d.corrected || '').trim();
				$('fb-corrected2').textContent = reshadowTarget;
				$('fb-reshadow-fb').hidden = true;
				saveProduction(d);
			},
		};
		wire('produce');
		$('fb-play').addEventListener('click', () => say($('fb-model').textContent, 0.85));

		// immediate re-practice: shadow the corrected sentence right after feedback
		let reshadowTarget = '';
		$('fb-corr-play').addEventListener('click', () => say(reshadowTarget, 0.85));
		targets['reshadow'] = {
			buildPayload: () => ({ mode: 'shadow', target: reshadowTarget }),
			setLabel: (label) => { const b = btnFor('reshadow'); b.textContent = label; b.disabled = label.includes('듣는'); },
			reset: () => { btnFor('reshadow').textContent = '🎤 다시 말하기'; btnFor('reshadow').disabled = false; },
			onError: (msg) => { $('t-reshadow').textContent = msg; $('fb-reshadow-fb').hidden = false; btnFor('reshadow').textContent = '🎤 따라 말하기'; btnFor('reshadow').disabled = false; },
			render: (d) => {
				$('t-reshadow').textContent = d.transcript ? `🗣️ ${d.transcript}` : '(못 알아들었어요 — 다시 한 번!)';
				$('g-reshadow').textContent = d.good || '';
				$('tip-reshadow').textContent = d.tip || '';
				$('fb-reshadow-fb').hidden = false;
			},
		};
		wire('reshadow');

		if (mimeType === null) {
			document.querySelectorAll('.rec-btn').forEach((b) => (b.disabled = true));
			pHint.textContent = '이 브라우저는 녹음을 지원하지 않아요. Chrome 또는 Safari를 사용해 주세요.';
		}

		// --- streak + log (local calendar day) ---
		function loadLog() { try { return JSON.parse(localStorage.getItem('speakLog') || '[]'); } catch (e) { return []; } }
		function isoDay(d) {
			const y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0'), day = String(d.getDate()).padStart(2, '0');
			return `${y}-${m}-${day}`;
		}
		// Lesson date for this page (falls back to today if the attribute is missing).
		const ISSUE_DAY = (document.querySelector('.speak') && document.querySelector('.speak').dataset.issueDate) || isoDay(new Date());
		function computeStreak(dates, todayStr) {
			const set = new Set(dates);
			let d = new Date(todayStr + 'T00:00:00');
			if (!set.has(isoDay(d))) d.setDate(d.getDate() - 1);
			let n = 0;
			while (set.has(isoDay(d))) { n++; d.setDate(d.getDate() - 1); }
			return n;
		}
		function esc(x) { return String(x || '').replace(/</g, '&lt;'); }
		function saveProduction(d) {
			const corrected = (d.corrected || '').trim();
			if (corrected) {
				try {
					const log = loadLog();
					log.unshift({ date: isoDay(new Date()), issueDate: ISSUE_DAY, corrected, ko: (d.ko || '').trim(), mistakes: Array.isArray(d.mistakes) ? d.mistakes.slice(0, 3) : [] });
					localStorage.setItem('speakLog', JSON.stringify(log.slice(0, 60)));
				} catch (e) {}
			}
			renderStreakAndLog();
		}
		function renderStreakAndLog() {
			const log = loadLog();
			const streak = computeStreak(log.map((e) => e.date), isoDay(new Date()));
			const streakEl = $('streak');
			if (streak > 0) { streakEl.textContent = `🔥 ${streak}일 연속`; streakEl.hidden = false; }
			else streakEl.hidden = true;
			const logEl = $('log'), listEl = $('log-list'), sumEl = $('mistake-summary');
			if (!log.length) { logEl.hidden = true; return; }
			// recurring-mistake summary (aggregate by type)
			const counts = {};
			log.forEach((e) => (e.mistakes || []).forEach((m) => { const t = (m.type || '').trim(); if (t) counts[t] = (counts[t] || 0) + 1; }));
			const top = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 3);
			if (top.length) { sumEl.innerHTML = '자주 틀리는 것: ' + top.map(([t, n]) => `<span class="mtag">${esc(t)} ${n}회</span>`).join(' '); sumEl.hidden = false; }
			else sumEl.hidden = true;
			// clean list: corrected sentence + its mistakes (no messy transcript)
			listEl.innerHTML = '';
			log.slice(0, 20).forEach((e) => {
				const li = document.createElement('li');
				li.className = 'log-item';
				let html = `<span class="log-date">${esc(e.issueDate || e.date)}</span>`;
				if (e.corrected) html += `<span class="log-better">✅ ${esc(e.corrected)}</span>`;
				(e.mistakes || []).forEach((m) => { html += `<span class="log-mistake">✏️ ${esc(m.error)} → <b>${esc(m.fix)}</b>${m.type ? ` <i>(${esc(m.type)})</i>` : ''}</span>`; });
				li.innerHTML = html;
				listEl.appendChild(li);
			});
			logEl.hidden = false;
		}
		function buildReview() {
			const today = isoDay(new Date());
			const log = loadLog();
			const seen = new Set(), items = [];
			for (const e of log) {
				if (e.date === today) continue;
				const c = (e.corrected || '').trim(), k = (e.ko || '').trim();
				if (!c || !k || seen.has(c)) continue;
				seen.add(c); items.push({ corrected: c, ko: k });
				if (items.length >= 2) break;
			}
			if (!items.length) return;
			const list = $('review-list');
			items.forEach((it, i) => {
				const id = `rv${i}`;
				const card = document.createElement('div');
				card.className = 'card ladder-card';
				card.innerHTML = `<p class="lp-ko">${esc(it.ko)}</p>`
					+ `<div class="ladder-actions"><button class="rec-btn rec-btn-sm" data-rec="${id}" type="button">🎤 영어로 말하기</button>`
					+ `<button class="mini-btn" type="button" data-reveal="${id}">정답 보기</button></div>`
					+ `<div class="ladder-fb" id="fb-${id}" hidden><p id="t-${id}"></p><p id="g-${id}"></p><p id="tip-${id}"></p></div>`;
				list.appendChild(card);
				targets[id] = {
					buildPayload: () => ({ mode: 'translate', target: it.corrected, ko: it.ko }),
					setLabel: (label) => { const b = btnFor(id); b.textContent = label; b.disabled = label.includes('듣는'); },
					reset: () => { btnFor(id).textContent = '🎤 다시 말하기'; btnFor(id).disabled = false; },
					onError: (msg) => { $(`t-${id}`).textContent = msg; $(`fb-${id}`).hidden = false; btnFor(id).textContent = '🎤 영어로 말하기'; btnFor(id).disabled = false; },
					render: (d) => { $(`t-${id}`).textContent = d.transcript ? `🗣️ ${d.transcript}` : '(못 알아들었어요 — 다시 한 번!)'; $(`g-${id}`).textContent = d.good || ''; $(`tip-${id}`).textContent = d.corrected ? `✏️ ${d.corrected}` : ''; $(`fb-${id}`).hidden = false; },
				};
				wire(id);
				card.querySelector(`[data-reveal="${id}"]`).addEventListener('click', () => { $(`t-${id}`).textContent = `✅ ${it.corrected}`; $(`fb-${id}`).hidden = false; });
			});
			$('review').hidden = false;
		}
		renderStreakAndLog();
		buildReview();
	</script>

