---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { FEATURES, CATEGORIES, categoryLabel } from '../config';

const rawIssues = await getCollection('issues');
const issues = rawIssues.sort((a, b) => {
	const dateA = new Date(a.data.date);
	const dateB = new Date(b.data.date);
	return dateB.valueOf() - dateA.valueOf();
});

const issueDay = (date: string | Date): string =>
	date instanceof Date ? date.toISOString().slice(0, 10) : String(date).slice(0, 10);

// Episodes shown on a card. Enough to tell what's inside without turning the
// list into a wall — the rest are summarised as "+N편". A category filter
// shows every matching episode, extras included.
const PREVIEW = 4;

const totalEpisodes = issues.reduce((n, i) => n + (i.data.articles?.length ?? 0), 0);

// One chip per category that has any episodes, counted in episodes: an issue
// mixes subjects on purpose, so "N issues" would say little.
const catCounts = new Map<string, number>();
for (const issue of issues) {
	for (const a of issue.data.articles ?? []) {
		if (a.category) catCounts.set(a.category, (catCounts.get(a.category) ?? 0) + 1);
	}
}
const chips = CATEGORIES.filter((c) => catCounts.has(c.id)).map((c) => ({
	...c,
	count: catCounts.get(c.id) ?? 0,
}));
---

<BaseLayout title="YouTube Digest — 아카이브">
	<section class="archive-hero">
		<h1>보는 대신,<br />읽는 <em>영어</em>.</h1>
		<p>
			유튜브 영상을 영어 기사로 옮겨 영어·한국어로 나란히 싣습니다.
			지금까지 {issues.length}호, 에피소드 {totalEpisodes}편.
			본문은 대목마다 요약만 보이고, 누르면 전문이 열립니다.
		</p>
	</section>

	{issues.length > 0 && (
		<>
			<div class="archive-search">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
				<input
					type="search"
					id="issue-search"
					placeholder="한글·영어로 검색 — 제목, 채널, 본문 소제목까지"
					autocomplete="off"
					aria-label="아카이브 검색"
				/>
				<button type="button" class="search-clear" id="search-clear" hidden aria-label="검색어 지우기">&times;</button>
			</div>
			{chips.length > 0 && (
				<nav class="cat-filter" aria-label="카테고리">
					<button type="button" class="cat-chip" data-cat="" aria-pressed="true">
						전체 <span class="cat-count">{totalEpisodes}</span>
					</button>
					{chips.map((c) => (
						<button type="button" class="cat-chip" data-cat={c.id} data-label={c.label} aria-pressed="false">
							<span class="cat-dot" aria-hidden="true"></span>{c.label} <span class="cat-count">{c.count}</span>
						</button>
					))}
				</nav>
			)}
			<p class="search-status" id="search-status" aria-live="polite"></p>
		</>
	)}

	{issues.length === 0 ? (
		<div class="search-empty">
			<strong>아직 발행된 호가 없습니다</strong>
			<span>파이프라인을 한 번 실행하면 여기에 쌓입니다.</span>
		</div>
	) : (
		<>
			<ul class="issue-list" id="issue-list">
				{issues.map((issue, index) => {
					const day = issueDay(issue.data.date);
					const dateObj = new Date(issue.data.date);
					const formattedDate = dateObj.toLocaleDateString('ko-KR', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					});
					const articles = issue.data.articles ?? [];
					const rest = articles.length - Math.min(articles.length, PREVIEW);
					const hasAudio = FEATURES.audio && (issue.data.audioUrls?.length ?? 0) > 0;

					// Lowercased haystacks, filtered in the browser — no index to
					// build or ship. The card's covers the issue as a whole; each
					// episode carries its own so a category filter can skip the
					// other episodes' text.
					const haystack = [issue.data.subject, day, formattedDate].join(' ').toLowerCase();

					return (
						<li>
							<a
								href={`/issues/${issue.id}`}
								class="issue-card"
								data-search={haystack}
								data-slug={issue.id}
								data-cats={articles.map((a) => a.category).join('|')}
							>
								<div class="issue-card-top">
									<span class="issue-date">{formattedDate}</span>
									{index === 0 && <span class="issue-flag is-new">최신호</span>}
									<span class="issue-flag" data-read-flag hidden>읽음</span>
								</div>

								<h2 class="issue-title">{issue.data.subject}</h2>

								{articles.length > 0 && (
									<ol class="issue-contents">
										{articles.map((a, i) => (
											<li
												class={i >= PREVIEW ? 'is-extra' : undefined}
												hidden={i >= PREVIEW}
												data-cat={a.category || undefined}
												data-search={`${a.title} ${a.channel} ${a.summary ?? ''}`.toLowerCase()}
											>
												<span class="ep-num">{String(i + 1).padStart(2, '0')}</span>
												<span class="ep-title">{a.title}</span>
												{a.category && <span class="ep-cat">{categoryLabel(a.category)}</span>}
												<span class="ep-channel">{a.channel}</span>
											</li>
										))}
									</ol>
								)}

								<div class="issue-meta">
									{articles.length > 0 && (
										<span class="badge">
											에피소드 {articles.length}편{rest > 0 && <span data-rest>{` · 그 외 ${rest}편 더`}</span>}
										</span>
									)}
									{issue.data.speakingPrompt && <span class="badge">오늘의 한 마디</span>}
									{hasAudio && <span class="badge">오디오</span>}
									<span class="read-more">읽기 &rarr;</span>
								</div>
							</a>

							<ul class="issue-hits" data-hits-for={issue.id} hidden></ul>
						</li>
					);
				})}
			</ul>

			<div class="search-empty" id="search-empty" hidden>
				<strong>검색 결과가 없습니다</strong>
				<span>다른 낱말로 찾아보세요.</span>
			</div>
		</>
	)}
</BaseLayout>

<script>
	// Mark issues already opened, using the same key the issue page writes.
	document.addEventListener('DOMContentLoaded', () => {
		let read: Set<string>;
		try {
			read = new Set(JSON.parse(localStorage.getItem('yt-digest-read-issues') || '[]'));
		} catch {
			return;
		}
		document.querySelectorAll<HTMLElement>('.issue-card').forEach((card) => {
			const slug = card.dataset.slug;
			if (slug && read.has(slug)) {
				const flag = card.querySelector<HTMLElement>('[data-read-flag]');
				if (flag) flag.hidden = false;
			}
		});
	});
</script>

<script>
	// Search runs in two layers so typing is never blocked:
	//   1. Card level, instantly, from the inline haystacks.
	//   2. Section level, once /search-index.json arrives — ~4,700 headings
	//      with their summaries, in both languages, each linking straight to
	//      its anchor. Too big to inline, so it's prefetched the moment the
	//      box is focused (and on idle), long before anyone finishes typing.
	// The category chips narrow both layers to one subject's episodes, and
	// the choice lives in ?cat= so a filtered list can be linked and survives
	// the back button.
	document.addEventListener('DOMContentLoaded', () => {
		const input = document.getElementById('issue-search') as HTMLInputElement | null;
		const clear = document.getElementById('search-clear');
		const status = document.getElementById('search-status');
		const empty = document.getElementById('search-empty');
		const list = document.getElementById('issue-list');
		if (!input || !list) return;

		type Item = { s: string; t: string; d: string; l: number; a?: number };
		type Entry = { id: string; subject: string; items: Item[] };

		const items = Array.from(list.querySelectorAll<HTMLAnchorElement>('.issue-card')).map((card) => {
			const row = card.parentElement as HTMLElement;
			const title = card.querySelector('.issue-title') as HTMLElement;
			return {
				card,
				row,
				id: card.dataset.slug || '',
				hay: card.dataset.search || '',
				cats: (card.dataset.cats || '').split('|'),
				eps: Array.from(card.querySelectorAll<HTMLElement>('.issue-contents > li')),
				rest: card.querySelector<HTMLElement>('[data-rest]'),
				title,
				titleText: title?.textContent || '',
				hits: row.querySelector('.issue-hits') as HTMLElement,
			};
		});

		const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-chip'));
		const known = new Set(chips.map((c) => c.dataset.cat || ''));
		let cat = new URLSearchParams(location.search).get('cat') || '';
		if (!known.has(cat)) cat = '';

		let index: Map<string, Item[]> | null = null;
		let loading = false;

		function loadIndex() {
			if (index || loading) return;
			loading = true;
			fetch('/search-index.json')
				.then((r) => (r.ok ? r.json() : null))
				.then((data: Entry[] | null) => {
					if (!data) return;
					index = new Map(data.map((e) => [e.id, e.items]));
					if (input!.value.trim()) run(); // repaint whatever is on screen
				})
				.catch(() => {})
				.finally(() => {
					loading = false;
				});
		}

		input.addEventListener('focus', loadIndex, { once: true });
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(loadIndex, { timeout: 4000 });
		} else {
			setTimeout(loadIndex, 2500);
		}

		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

		/** Escape `text`, wrapping every case-insensitive occurrence of `term`
		 *  in a <mark>. Scanned rather than regexed so the query needs no
		 *  escaping — searches contain "?", "(", "." all the time. */
		function mark(text: string, term: string) {
			if (!term) return esc(text);
			const hay = text.toLowerCase();
			let out = '';
			let from = 0;
			for (;;) {
				const at = hay.indexOf(term, from);
				if (at === -1) return out + esc(text.slice(from));
				out +=
					esc(text.slice(from, at)) +
					'<mark class="hit">' +
					esc(text.slice(at, at + term.length)) +
					'</mark>';
				from = at + term.length;
			}
		}

		const MAX_HITS = 4;

		/** Sections of this issue matching `term`, limited to the chosen
		 *  category's episodes. A section whose episode is unknown (a = -1)
		 *  is kept — the card itself already passed the category check. */
		function sectionHits(item: (typeof items)[number], term: string): Item[] {
			if (!term || !index) return [];
			return (index.get(item.id) || []).filter((x) => {
				if (!x.t.toLowerCase().includes(term) && !x.d.toLowerCase().includes(term)) return false;
				const a = x.a ?? -1;
				return !cat || a < 0 || item.cats[a] === cat;
			});
		}

		function paintHits(item: (typeof items)[number], term: string, found: Item[]) {
			const box = item.hits;
			if (!box) return;

			if (found.length === 0) {
				box.hidden = true;
				box.innerHTML = '';
				return;
			}

			box.innerHTML =
				found
					.slice(0, MAX_HITS)
					.map(
						(x) =>
							`<li><a href="/issues/${item.id}#${encodeURIComponent(x.s)}" class="hit-link">` +
							`<span class="hit-head">${mark(x.t, term)}</span>` +
							(x.d ? `<span class="hit-snip">${mark(x.d, term)}</span>` : '') +
							`</a></li>`
					)
					.join('') +
				(found.length > MAX_HITS
					? `<li class="hit-more">이 호에 ${found.length - MAX_HITS}곳 더</li>`
					: '');
			box.hidden = false;
		}

		function run() {
			const raw = input!.value.trim();
			const term = raw.toLowerCase();
			let shown = 0;
			let hitCount = 0;
			let epCount = 0;

			for (const item of items) {
				const catEps = cat ? item.eps.filter((li) => li.dataset.cat === cat) : item.eps;
				const found = sectionHits(item, term);
				const match =
					catEps.length > 0 &&
					(!term ||
						(!cat && item.hay.includes(term)) ||
						catEps.some((li) => (li.dataset.search || '').includes(term)) ||
						found.length > 0);

				item.row.hidden = !match;
				if (!match) continue;

				shown++;
				hitCount += found.length;
				epCount += catEps.length;
				for (const li of item.eps) {
					li.hidden = cat ? li.dataset.cat !== cat : li.classList.contains('is-extra');
				}
				if (item.rest) item.rest.hidden = !!cat;
				if (item.title) {
					item.title.innerHTML = term ? mark(item.titleText, term) : esc(item.titleText);
				}
				paintHits(item, term, found);
			}

			if (clear) clear.hidden = !raw;
			if (empty) empty.hidden = shown > 0 || (!raw && !cat);
			if (status) {
				const chip = chips.find((c) => (c.dataset.cat || '') === cat);
				const label = cat && chip ? esc(chip.dataset.label || '') : '';
				if (!raw) {
					status.innerHTML = label ? `${label} · 에피소드 <b>${epCount}</b>편` : '';
				} else {
					const detail = hitCount > 0 ? ` · 본문 ${hitCount}곳` : index ? '' : ' · 본문 검색 준비 중…';
					status.innerHTML = `${label ? `${label} · ` : ''}<b>${shown}</b>개 호${detail}`;
				}
			}
		}

		function setCategory(next: string) {
			cat = next;
			// A card's headline is its first episode's title, often another
			// subject's — under a filter the matching episodes take its place.
			list!.classList.toggle('is-filtered', !!cat);
			for (const chip of chips) {
				chip.setAttribute('aria-pressed', String((chip.dataset.cat || '') === cat));
			}
			const url = new URL(location.href);
			if (cat) url.searchParams.set('cat', cat);
			else url.searchParams.delete('cat');
			history.replaceState(history.state, '', url);
			run();
		}

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				const next = chip.dataset.cat || '';
				// Pressing the active chip again goes back to everything.
				setCategory(next === cat ? '' : next);
			});
		}
		if (cat) setCategory(cat);

		// No debounce: this is a few thousand substring checks, cheaper than
		// the frame a rAF would wait for.
		input.addEventListener('input', run);

		input.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				input.value = '';
				run();
			}
		});

		clear?.addEventListener('click', () => {
			input.value = '';
			input.focus();
			run();
		});

		// "/" focuses search, the way every archive should behave.
		document.addEventListener('keydown', (e) => {
			if (e.key === '/' && document.activeElement !== input) {
				e.preventDefault();
				input.focus();
				input.select();
			}
		});
	});
</script>
